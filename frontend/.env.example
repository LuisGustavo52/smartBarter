# smartBarter - Configurações de ambiente do Frontend
# Para desenvolvimento local, copie este arquivo para .env.local:
#   cp .env.example .env.local
# O script resetup.sh atualiza NEXT_PUBLIC_CONTRACT_ADDRESS automaticamente em .env.local após o deploy.

# Endereço do contrato SmartBarterCPR (atualizado automaticamente pelo resetup.sh)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# URL base da API NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL do nó RPC da blockchain local (Hardhat)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Client ID do Thirdweb
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=d3690d56bdafa6a3cd84d948259dbbe0

# Domínio da aplicação frontend
NEXT_PUBLIC_DOMAIN=localhost:3000
